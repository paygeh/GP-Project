# ── Copy to .env and fill in ────────────────────────────────────────────────

# DEV: SQLite (zero setup)
DATABASE_URL="file:./dev.db"
# PRODUCTION (Neon / PostgreSQL): set provider="postgresql" in prisma/schema.prisma
# and use your connection string, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Random secret for signing the admin session cookie (min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Stylist/admin login.
ADMIN_EMAIL="you@yoursalon.com"
# bcrypt hash of your password. Generate one: npm run hash
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# ── Email: notify Lizzy of new appointment requests ─────────────────────────
# Uses Resend (https://resend.com). Free tier is plenty for notifications.
# If RESEND_API_KEY or NOTIFY_EMAIL is blank, requests still save and the email
# is logged to the server console instead of sent.
RESEND_API_KEY=""
# Where request notifications are sent (Lizzy's inbox).
NOTIFY_EMAIL="lizzy@example.com"
# Sender. "onboarding@resend.dev" works out of the box and can send to the
# Resend account owner's email; use your own verified domain for anything else.
FROM_EMAIL="Imagine That <onboarding@resend.dev>"
