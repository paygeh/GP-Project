# ── Copy to .env and fill in ────────────────────────────────────────────────

# DEV: SQLite (zero setup)
DATABASE_URL="file:./dev.db"
# PRODUCTION (Neon / PostgreSQL): set provider="postgresql" in prisma/schema.prisma
# and use your connection string, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Random secret for signing the admin session cookie (min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Stylist/admin login.
ADMIN_EMAIL="you@yoursalon.com"
# bcrypt hash of your password. Generate one: npm run hash
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"
