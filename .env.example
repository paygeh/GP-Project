# ── Copy to .env and fill in ────────────────────────────────────────────────

# DEV: SQLite (zero setup)
DATABASE_URL="file:./dev.db"
# PRODUCTION (Neon / PostgreSQL): set provider="postgresql" in prisma/schema.prisma
# and use your connection string, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Random secret for signing the admin session cookie (min 32 chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Stylist/admin login.
ADMIN_EMAIL="you@yoursalon.com"
# bcrypt hash of your password. Generate one: npm run hash -- "your-password"
# (the script prints it with the $ escaped as \$, which Next.js requires).
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# ── Email: notify Lizzy + send clients a request summary ────────────────────
# Sends via Gmail SMTP. Create a Google App Password (Google Account → Security
# → App passwords; requires 2-step verification), ideally on a dedicated sender
# account. If GMAIL_* is blank, requests still save and emails log to the
# console. Gmail can send to any inbox (free, ~500/day).
GMAIL_USER="yourbookings@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
# Where new-request notifications go (Lizzy's inbox — any address).
NOTIFY_EMAIL="lizzy@example.com"
# Sender shown on outgoing mail (must be the GMAIL_USER address).
FROM_EMAIL="Imagine That <yourbookings@gmail.com>"
